# Configuración de Base de Datos para VTT D&D 5e
# En Render, Render asigna automáticamente la variable DATABASE_URL si conectas una base de datos Postgres.

# URL de conexión directa a PostgreSQL (ejemplo de Render / Supabase / Neon / Local):
# DATABASE_URL=postgresql://usuario:contraseña@servidor.render.com/nombre_base_datos

# O parámetros individuales:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=tu_password
# PGDATABASE=vtt_dnd

# Si no defines ninguna variable PostgreSQL, el servidor usará automáticamente SQLite local (data/vtt.db).
PORT=3000
